{
  "name": "emberline-web",
  "version": "0.1.0",
  "private": true,
  "description": "EMBERLINE 프런트 — Next.js App Router 정적 내보내기(output: export) · FSD · 목업 기반",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --port 8797",
    "build": "next build",
    "serve:out": "node scripts/serve-out.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "steiger": "steiger ./src",
    "test": "vitest run",
    "check:isolation": "node scripts/check-isolation.mjs",
    "check:leaks": "node scripts/check-public-leaks.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm steiger && pnpm check:isolation && pnpm check:leaks && pnpm test",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript contract/openapi.yaml -o src/shared/api/schema.d.ts",
    "import:i18n": "node scripts/import-i18n.mjs",
    "import:tokens": "node scripts/import-tokens.mjs",
    "import:geo": "node scripts/import-geo.mjs",
    "import:ledger": "node scripts/import-ledger.mjs",
    "import:snapshot": "node scripts/import-snapshot.mjs",
    "msw:init": "msw init public --no-save"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.65.0",
    "maplibre-gl": "5.24.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "openapi-fetch": "0.17.0",
    "pretendard": "1.3.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.8.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.32",
    "steiger": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "msw"
    ]
  }
}
