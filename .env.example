# 어댑터 교체 — 한 줄씩. 빌드 때 값이 박힌다(NEXT_PUBLIC_*, 정적 내보내기).
# 실제 데이터(캘린더·분석·방법·상황판 통합 값·전망): msw = 브라우저 MSW 가 public/data 스냅숏을 응답 · http = 실제 백엔드
NEXT_PUBLIC_DATA_MODE=msw
# 실제 백엔드 주소(DATA_MODE=http 일 때). 같은 출처면 /api/v1
NEXT_PUBLIC_API_BASE=/api/v1
# 기관 연동(ops·land·cmd·경북 시나리오 원장): mock = src/shared/mock/agency · http = /api/v1/agency/** (백엔드 자리만 예약, 미구현)
NEXT_PUBLIC_AGENCY_ADAPTER=mock
# 로그인: mock = 예시 로그인 + 역할 선택(src/shared/mock/auth) · http = /api/v1/auth/** (미구현)
NEXT_PUBLIC_AUTH_ADAPTER=mock
